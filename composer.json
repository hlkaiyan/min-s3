{
    "name": "hlkaiyan/min-s3",
    "description": "轻量 S3 客户端，面向自建 S3 服务器（MinIO / Ceph / 其他 S3 兼容存储），零第三方依赖",
    "keywords": ["s3", "minio", "ceph", "object-storage", "aws", "s3-client"],
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/hlkaiyan/min-s3",
    "authors": [
        {
            "name": "hlkaiyan",
            "homepage": "https://github.com/hlkaiyan"
        }
    ],
    "support": {
        "issues": "https://github.com/hlkaiyan/min-s3/issues",
        "source": "https://github.com/hlkaiyan/min-s3"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "ext-json": "*",
        "ext-xmlwriter": "*"
    },
    "autoload": {
        "psr-4": {
            "MinS3\\": "src/"
        },
        "exclude-from-classmap": [
            "src/data/"
        ]
    },
    "scripts": {
        "test": "php tests/run.php",
        "scan": "php tests/audit.php",
        "hooks:install": "git config core.hooksPath .githooks"
    },
    "scripts-descriptions": {
        "test": "运行全部测试（零依赖检查、端到端、README 示例、真实 HTTP 传输）",
        "scan": "扫描仓库中的敏感信息（名字不用 audit，那是 Composer 的内置命令）",
        "hooks:install": "启用 pre-commit 敏感信息扫描（仅本仓库，不改全局 git 配置）"
    },
    "config": {
        "sort-packages": true
    }
}
